# 强制 Windows 批处理与 PowerShell 脚本使用 CRLF 行尾
# 原因：cmd.exe 对 LF-only 的 .bat 会出现多行粘连，rem 注释可能吞掉后续命令；
#      PowerShell 5.1 对 LF 容忍，但统一 CRLF 与 Windows 习惯一致。
# text eol=crlf 让 git 在工作区检出时写 CRLF，并在提交时记录为标准形式。
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 源码与文档统一 LF（避免跨平台 diff 噪音）
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf

# 图片等二进制
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
